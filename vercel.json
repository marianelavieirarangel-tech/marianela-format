{
  "builds": [
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    }
  ],
  "routes": [
    { "handle": "filesystem" },
    { "src": "/api/shopify/products", "dest": "/api/shopify/products.js" },
    { "src": "/api/shopify/checkout", "dest": "/api/shopify/checkout.js" },
    { "src": "/api/shopify/newsletter", "dest": "/api/shopify/newsletter.js" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
